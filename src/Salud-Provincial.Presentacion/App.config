<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Autenticación de Windows: no lleva usuario ni clave, así que es seguro subirlo a GitHub.
         Si usas SQL Server Express, cambia Server por .\SQLEXPRESS -->
    <add name="SaludDB"
         connectionString="Server=(localdb)\MSSQLLocalDB;Database=SaludDB;Trusted_Connection=True;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
